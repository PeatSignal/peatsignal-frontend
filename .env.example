# Frontend berjalan tanpa variabel lingkungan: default memakai mock repository (data DEMO).

# Sumber data: "mock" (default) atau "rest". "rest" hanya aktif bila NEXT_PUBLIC_API_BASE_URL terisi.
# NEXT_PUBLIC_DATA_SOURCE=rest
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Token peran DEMO (Authorization: Bearer). Wajib di mode rest untuk masuk di /login
# (diverifikasi lewat GET /auth/me) serta membuat tugas, mengirim laporan, dan meninjau. Nilai di bawah adalah
# token development backend; ikut terkirim ke browser, jadi bukan autentikasi sungguhan.
# NEXT_PUBLIC_DEMO_COORDINATOR_TOKEN=demo-coordinator-token
# NEXT_PUBLIC_DEMO_FIELD_OFFICER_TOKEN=demo-field-officer-token

# Peta dasar MapLibre (opsional). Default: OpenFreeMap Positron, tanpa API key.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Jangan pernah menaruh FIRMS_MAP_KEY, DATABASE_URL, atau token auth di NEXT_PUBLIC_*.
# Semua nilai NEXT_PUBLIC_* ikut terkirim ke browser.
